{
  "name": "ringzero",
  "version": "0.4.0",
  "description": "Minimal token-efficient agent harness (zero-dep kernel, Ink-based TUI)",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "agent",
    "harness",
    "llm",
    "cli",
    "tui",
    "mcp",
    "token-efficient"
  ],
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "ringzero": "./dist/src/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "smoke:agent": "npm run build && node dist/scripts/agent-smoke.js",
    "e2e": "npm run build && node dist/scripts/e2e-app.js",
    "e2e:webapp": "npm run build && node dist/scripts/e2e-webapp.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  }
}
